{import { 
  createFileRoute } from "@tanstack/react-router";
  import { useState } from "react";
  import { Wand2, Plus, Trash2, Info } from "lucide-react";
  import { PageHeader } from "@/components/site/Shell";
  import { usePlanning } from "@/lib/planning/store";
  import { usePlanCopy } from "@/lib/planning/copy";
  import { PlanTabs, StorageStatus, Field, inputClass } from "@/components/planning/Shared";
  import {
    categories,
    localDate,
    timeLabel,
    type Task,
    type Settings,
  } from "@/lib/planning/model";
  import { generateSchedule } from "@/lib/planning/scheduler";
  
  export const Route = createFileRoute("/create")({
    head: () => ({
      meta: [
        { title: "Create My Plan — NIZTIME AI" },
        { name: "description", content: "Build a personal schedule from your tasks and availability." },
      ],
    }),
    component: CreatePlan,
  });
  
  function CreatePlan() {
    const { c } = usePlanCopy();
    const { store, ready, error, update } = usePlanning();
  
    const [title, setTitle] = useState("");
    const [category, setCategory] = useState<Task["category"]>("study");
    const [priority, setPriority] = useState<Task["priority"]>("medium");
    const [difficulty, setDifficulty] = useState<Task["difficulty"]>("medium");
    const [duration, setDuration] = useState(60);
    const [deadline, setDeadline] = useState("");
    const [settings, setSettings] = useState<Settings>(store.settings);
    const [notice, setNotice] = useState("");
  
    const changeSetting = <K extends keyof Settings>(key: K, value: Settings[K]) => {
      setSettings((previous) => ({ ...previous, [key]: value }));
    };
  
    const addTask = () => {
      if (!title.trim() || !ready) return;
  
      const task: Task = {
        id: ${Date.now()},
        title: title.trim(),
        category,
        priority,
        difficulty,
        duration,
        deadline,
      };
  
      if (update({ ...store, tasks: [...store.tasks, task] })) {
        setTitle("");
        setDeadline("");
        setNotice(c.taskSaved);
      }
    };
  
    const removeTask = (id: string) => {
      update({
        ...store,
        tasks: store.tasks.filter((task) => task.id !== id),
        entries: store.entries.filter((entry) => entry.task.id !== id || entry.completedAt !== null),
        unscheduled: store.unscheduled.filter((item) => item.taskId !== id),
      });
    };
  
    const generate = () => {
      if (!ready || store.tasks.length === 0) {
        setNotice(c.noTasksGenerate);
        return;
      }
  
      try {
        const next = generateSchedule(
          { ...store, settings },
          localDate(),
          new Date().getHours() * 60 + new Date().getMinutes()
        );
  
        if (update(next)) setNotice(c.generated);
      } catch {
        setNotice(c.invalid);
      }
    };
  
    const today = localDate();
    const dates = [...new Set(store.entries.map((entry) => entry.date))].sort();
  
    return (
      <div className="mx-auto max-w-5xl px-4 py-10 sm:px-6">
        <PlanTabs active="smart" />
        <PageHeader title={c.smart} sub={c.smartSub} />
        <StorageStatus />
  
        <div className="space-y-6">
          <section className="glass space-y-4 p-6">
            <h2 className="font-semibold">1 · {c.availability}</h2>
  
            <Field label={c.hours}>
              <input
                type="number"
                min="0.5"
                max="16"
                step="0.5"
                className={inputClass}
                value={settings.hours}
                onChange={(e) => changeSetting("hours", Number(e.target.value))}
              />
            </Field>
  
            <div className="grid gap-4 sm:grid-cols-2">
              <Field label={c.start}>
                <input
                  type="time"
                  className={inputClass}
                  value={settings.start}
                  onChange={(e) => changeSetting("start", e.target.value)}
                />
              </Field>
              <Field label={c.end}>
                <input
                  type="time"
                  className={inputClass}
                  value={settings.end}
                  onChange={(e) => changeSetting("end", e.target.value)}
                />
              </Field>
            </div>
  
            <div className="grid gap-4 sm:grid-cols-2">
              <Field label={c.breaks}>
                <input
                  type="number"
                  min="5"
                  max="60"
                  className={inputClass}
                  value={settings.breakMinutes}
                  onChange={(e) => changeSetting("breakMinutes", Number(e.target.value))}
                />
              </Field>
              <Field label={c.period}>
                <select
                  className={inputClass}
                  value={settings.period}
                  onChange={(e) => changeSetting("period", e.target.value as Settings["period"])}
                >
                  <option value="today">{c.today}</option>
                  <option value="week">{c.week}</option>
                </select>
              </Field>
            </div>
          </section>
  
          <section className="glass space-y-4 p-6">
            <h2 className="font-semibold">2 · {c.tasks}</h2>
  
            <Field label={c.title}>
              <input
                className={inputClass}
                value={title}
                placeholder={c.title}
                onChange={(e) => setTitle(e.target.value)}
              />
            </Field>
  
            <div className="grid gap-4 sm:grid-cols-2">
              <Field label={c.category}>
                <select
                  className={inputClass}
                  value={category}
                  onChange={(e) => setCategory(e.target.value as Task["category"])}
                >
                  {categories.map((item) => (
                    <option key={item} value={item}>{c[item]}</option>
                  ))}
                </select>
              </Field>
  
              <Field label={c.priority}>
                <select
                  className={inputClass}
                  value={priority}
                  onChange={(e) => setPriority(e.target.value as Task["priority"])}
                >
                  <option value="high">{c.high}</option>
                  <option value="medium">{c.medium}</option>
                  <option value="low">{c.low}</option>
                </select>
              </Field>
            </div>
  
            <div className="grid gap-4 sm:grid-cols-2">
              <Field label={c.duration}>
                <input
                  type="number"
                  min="5"
                  max="1440"
                  className={inputClass}
                  value={duration}
                  onChange={(e) => setDuration(Number(e.target.value))}
                />
              </Field>
  
              <Field label={c.difficulty}>
                <select
                  className={inputClass}
                  value={difficulty}
                  onChange={(e) => setDifficulty(e.target.value as Task["difficulty"])}
                >
                  <option value="easy">{c.easy}</option>
                  <option value="medium">{c.medium}</option>
                  <option value="hard">{c.hard}</option>
                </select>
              </Field>
            </div>
  
            <Field label={c.deadline}>
              <input
                type="date"
                className={inputClass}
                min={today}
                value={deadline}
                onChange={(e) => setDeadline(e.target.value)}
              />
            </Field>
  
            <button
              onClick={addTask}
              disabled={!ready || !title.trim()}
              className="flex w-full items-center justify-center gap-2 rounded-xl bg-secondary px-5 py-3 font-semibold disabled:opacity-50"
            >
              <Plus className="h-4 w-4" />
              {c.add}
            </button>
  
            <div className="space-y-2">
              {store.tasks.length === 0 && (
                <p className="py-4 text-center text-sm text-muted-foreground">{c.emptyTasks}</p>
              )}
  
              {store.tasks.map((task) => (
                <div key={task.id} className="flex items-center gap-3 rounded-xl bg-glass p-3">
                  <div className="min-w-0 flex-1">
                    <p className="break-words font-medium">{task.title}</p>
                    <p className="text-xs text-muted-foreground">
                      {c[task.category]} · {c[task.priority]} · {task.duration} {c.minutes}
                    </p>
                  </div>
                  <button
                    onClick={() => removeTask(task.id)}
                    aria-label={c.delete}
                    className="text-muted-foreground hover:text-destructive"
                  >
                    <Trash2 className="h-4 w-4" />
                  </button>
                </div>
              ))}
            </div>
          </section>
  
          <button
            onClick={generate}
            disabled={!ready || store.tasks.length === 0}
            className="flex w-full items-center justify-center gap-2 rounded-full bg-gradient-brand py-4 font-semibold text-primary-foreground shadow-glow disabled:opacity-50"
          >
            <Wand2 className="h-5 w-5" />
            {c.generate}
          </button>
  
          {notice && <p role="status" className="text-sm text-neon-cyan">{notice}</p>}
  
          {error && <p role="alert" className="text-sm text-destructive">{c.saveError}</p>}
  
          {dates.length > 0 && (
            <section className="glass space-y-5 p-6">
              <h2 className="font-semibold">{c.schedule}</h2>
              <p className="flex items-start gap-2 text-xs text-muted-foreground">
                <Info className="h-4 w-4 shrink-0" />
                {c.storageNote}
              </p>
  
              {dates.map((date) => (
                <div key={date}>
                  <h3 className="mb-3 font-semibold" dir="ltr">{date}</h3>
                  <div className="space-y-2">
                    {store.entries
                      .filter((entry) => entry.date === date)
                      .map((entry) => (
                        <div key={entry.id} className="flex flex-wrap items-center gap-3 rounded-xl bg-glass p-3">
                          <span className="text-xs text-neon-cyan" dir="ltr">
                            {entry.segments.map((segment) => ${timeLabel(segment.start)}–${timeLabel(segment.end)}).join(" / ")}
                          </span>
                          <span className="flex-1 font-medium">{entry.task.title}</span>
                          <span className="text-xs text-muted-foreground">{c[entry.task.priority]}</span>
                          {entry.completedAt && <span className="text-xs text-neon-cyan">{c.done}</span>}
                        </div>
                      ))}
                  </div>
                </div>
              ))}
  
              {store.unscheduled.length > 0 && (
                <div className="border-t border-glass-border pt-4">
                  <h3 className="mb-2 font-semibold">{c.unscheduled}</h3>
                  {store.unscheduled.map((item) => {
                    const task = store.tasks.find((candidate) => candidate.id === item.taskId);
                    return task ? (
                      <p key={item.taskId} className="text-sm text-muted-foreground">
                        {task.title} — {item.reason === "capacity" ? c.capacity : c.expired}
                      </p>
                    ) : null;
                  })}
                </div>
              )}
            </section>
          )}
        </div>
      </div>
    );
  }
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "overrides": {
    "rolldown": "1.2.1"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "@tanstack/router-plugin": "1.168.42",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.2",
    "react-resizable-panels": "^4.6.5",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
